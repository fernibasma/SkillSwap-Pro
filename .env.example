# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Server-Side)
# Configure these variables in Secrets to connect SkillSwap Pro to your Supabase project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session & Security Secret
SESSION_SECRET=

# Moroccan Payment Gateway Configuration (Server-Side Only — Never expose to client)
# Supported providers: "sandbox" (default test mode), "cmi", "payzone"
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET=

# CMI (Centre Monétique Interbancaire — Maroc)
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL="https://payment.cmi.co.ma/fim/est3Dgate"

# Payzone Maroc
PAYZONE_MERCHANT_ID=
PAYZONE_SECRET_KEY=
PAYZONE_NOTIFICATION_KEY=
PAYZONE_API_URL="https://paiement.payzone.ma"

